# ── NORBEAI backend config ────────────────────────────────────
# Copy this file to .env at the project root and edit as needed.

# Host/port the FastAPI server listens on
HOST=0.0.0.0
PORT=8000

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Compute device: cpu (default) | cuda (requires CUDA PyTorch build)
DEVICE=cpu

# XTTS-v2 model id (downloaded automatically on first use)
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2

# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small

# Directory (relative to backend/) where voice profiles are stored
VOICES_DIR=voices

# Ollama LLM — powers the chat brain (leave empty or unset to disable)
OLLAMA_MODEL=gemma2:2b
